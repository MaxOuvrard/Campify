// Base brute (TimescaleDB) — voir ADR 0005. Reçoit toute mesure entrante
// telle quelle, sans filtre (y compris doublons/retards), avant que
// MeasurementIngestionService n'applique dedup/fraîcheur et n'écrive dans
// la base vérifiée (prisma/schema.prisma) que ce qui est retenu. Pas de
// relation vers Device : pure zone d'atterrissage, volume potentiellement
// très élevé, pour absorber l'ingestion sans dépendre du schéma relationnel.
datasource db {
  provider = "postgresql"
  url      = env("RAW_MEASUREMENTS_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/raw-client"
}

model RawMeasurement {
  id         String    @id @default(uuid())
  deviceId   String
  type       String
  value      Float
  unit       String?
  timestamp  DateTime
  messageId  String?
  receivedAt DateTime  @default(now())
  // Null tant que le worker de consolidation (driving/worker, voir ADR 0011)
  // n'a pas encore traité cette ligne (dédup/plausibilité + écriture en
  // base vérifiée). Renseigné qu'elle ait été acceptée ou rejetée — sert
  // uniquement à savoir ce qu'il reste à traiter, pas le résultat.
  consolidatedAt DateTime?

  @@index([deviceId, timestamp])
  @@index([consolidatedAt, receivedAt])
}
