NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://campify:campify@localhost:5432/campify?schema=public

# Base brute (TimescaleDB) : landing zone des mesures avant dedup/fraîcheur — voir ADR 0005
RAW_MEASUREMENTS_DATABASE_URL=postgresql://campify:campify@localhost:5433/campify_raw?schema=public

# Le mosquitto local (docker-compose.yml) exige désormais une identité —
# voir ADR 0008. Générer d'abord backend/mosquitto.passwd (README, section
# Démarrage) avec l'utilisateur "backend" et ce mot de passe local :
MQTT_URL=mqtt://backend:changeme-local-only@localhost:1883
MQTT_TOPIC_PREFIX=campus

JWT_SECRET=change-me-in-production

# Seuil de fraîcheur d'un device (ms) avant de le considérer hors-ligne
DEVICE_STALE_THRESHOLD_MS=300000

LOG_LEVEL=info
