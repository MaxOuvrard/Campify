datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

// Cycle de vie d'une commande — voir ADR 0014.
enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
  TIMEOUT
}

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  devices   Device[]
}

model Device {
  id           String        @id @default(uuid())
  name         String
  type         String
  room         Room          @relation(fields: [roomId], references: [id])
  roomId       String
  createdAt    DateTime      @default(now())
  measurements Measurement[]
  commands     Command[]

  // Pas de champ "dernière vue" mutable : la présence d'un device se
  // dérive de MAX(receivedAt) sur ses mesures (MeasurementRepository), déjà
  // historisées — pas de duplication d'état. Voir domain/services/freshness.ts.

  @@index([roomId])
}

// Hypertable TimescaleDB partitionnée par `timestamp` (migration
// 20261008090000_measurement_hypertable, ADR 0013). Prisma ne sait pas la
// déclarer : elle est créée en SQL dans la migration. Contrainte
// TimescaleDB : toute clé primaire doit contenir la colonne de partition,
// d'où la clé composite (id, timestamp). `id` reste unique en pratique
// (uuid), mais plus garanti par la base — ne jamais requêter par id seul
// (aucun code ne le fait : lectures par device/type/période).
model Measurement {
  id         String   @default(uuid())
  device     Device   @relation(fields: [deviceId], references: [id])
  deviceId   String
  type       String
  value      Float
  unit       String?
  timestamp  DateTime
  receivedAt DateTime @default(now())
  // Identifiant du message source (ex: message_id MQTT) : permet de
  // détecter une retransmission exacte indépendamment du timestamp.
  messageId  String?

  @@id([id, timestamp])
  @@index([deviceId, timestamp])
}

model Command {
  id        String        @id @default(uuid())
  device    Device        @relation(fields: [deviceId], references: [id])
  deviceId  String
  type      String
  params    Json
  status    CommandStatus @default(PENDING)
  createdAt DateTime      @default(now())
  // Au-delà, l'objet ne doit plus exécuter la commande (ADR 0014).
  expiresAt DateTime
  sentAt    DateTime?
  ackedAt   DateTime?
  // Motif d'échec (refus de l'objet, expiration…) et état réel rapporté
  // par l'objet dans son ACK.
  failureReason String?
  reportedState Json?
  timedOutAt    DateTime?
  // ACK reçu après le TIMEOUT : conservé, sans changer le statut.
  lateAckStatus String?
  lateAckAt     DateTime?

  @@index([deviceId])
  // Balayage des timeouts (worker) : commandes ouvertes par date d'expiration.
  @@index([status, expiresAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
}
