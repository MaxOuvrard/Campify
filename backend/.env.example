NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://campify:campify@localhost:5432/campify?schema=public

# Journal brut (MongoDB) : un document par message MQTT reçu, avant tout parsing — voir ADR 0013
MONGO_URL=mongodb://localhost:27017/campify_raw
# Les événements bruts sont supprimés automatiquement après ce délai (index TTL)
RAW_EVENTS_RETENTION_DAYS=30

# Le mosquitto local (docker-compose.yml) exige désormais une identité —
# voir ADR 0008. Générer d'abord backend/mosquitto.passwd (README, section
# Démarrage) avec l'utilisateur "backend" et ce mot de passe local :
MQTT_URL=mqtt://backend:changeme-local-only@localhost:1883
# Pour pointer vers le broker de démo du kit à la place (mesures réelles) :
# mqtt://<user>:<password>@<host>:<port> — identifiants à demander à
# l'équipe, ne jamais les commiter (voir ADR 0004, corrigé lors de l'audit
# secrets J3 après qu'ils s'y soient retrouvés en clair).
MQTT_TOPIC_PREFIX=campus

# QoS de souscription (0 ou 1). 1 par défaut (au moins une fois — voir la
# dédup par messageId, ADR 0005). Passer à 0 pour le scénario J3 de
# comparaison QoS 0 vs QoS 1 sur coupure/reprise du broker.
MQTT_QOS=1

# Groupe de souscription partagée MQTT (ADR 0012), utilisé uniquement par
# l'ingester (npm run ingester). Vide par défaut ici pour ne pas risquer de
# casser la connexion vers le broker du kit (support de $share non vérifié
# sur le VPS) ; positionné dans docker-compose.yml pour l'usage local, où
# ça permet de lancer plusieurs instances de l'ingester sans dupliquer
# l'ingestion (`docker compose up -d --scale ingester=3`).
# MQTT_SHARED_GROUP=campify-ingesters

JWT_SECRET=change-me-in-production

# Seuil de fraîcheur d'un device (ms) avant de le considérer hors-ligne
DEVICE_STALE_THRESHOLD_MS=300000

LOG_LEVEL=info

# Worker de consolidation (ADR 0011/0013, `npm run worker` / service `worker`
# du docker-compose) : fréquence de lecture du journal brut et taille max
# d'un lot.
CONSOLIDATION_POLL_INTERVAL_MS=3000
CONSOLIDATION_BATCH_SIZE=200
# Délai avant lecture d'un événement brut (laisse les insertions concurrentes devenir visibles)
CONSOLIDATION_SETTLE_MS=1000
