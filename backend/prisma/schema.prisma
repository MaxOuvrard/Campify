datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum CommandStatus {
  PENDING
  SENT
  ACKED
  FAILED
}

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  devices   Device[]
}

model Device {
  id           String        @id @default(uuid())
  name         String
  type         String
  room         Room          @relation(fields: [roomId], references: [id])
  roomId       String
  createdAt    DateTime      @default(now())
  measurements Measurement[]
  commands     Command[]
  alerts       Alert[]

  // Pas de champ "dernière vue" mutable : la présence d'un device se
  // dérive de MAX(receivedAt) sur ses mesures (MeasurementRepository), déjà
  // historisées — pas de duplication d'état. Voir domain/services/freshness.ts.

  @@index([roomId])
}

// Hypertable TimescaleDB partitionnée par `timestamp` (migration
// 20261008090000_measurement_hypertable, ADR 0013). Prisma ne sait pas la
// déclarer : elle est créée en SQL dans la migration. Contrainte
// TimescaleDB : toute clé primaire doit contenir la colonne de partition,
// d'où la clé composite (id, timestamp). `id` reste unique en pratique
// (uuid), mais plus garanti par la base — ne jamais requêter par id seul
// (aucun code ne le fait : lectures par device/type/période).
model Measurement {
  id         String   @default(uuid())
  device     Device   @relation(fields: [deviceId], references: [id])
  deviceId   String
  type       String
  value      Float
  unit       String?
  timestamp  DateTime
  receivedAt DateTime @default(now())
  // Identifiant du message source (ex: message_id MQTT) : permet de
  // détecter une retransmission exacte indépendamment du timestamp.
  messageId  String?

  @@id([id, timestamp])
  @@index([deviceId, timestamp])
}

model Command {
  id        String        @id @default(uuid())
  device    Device        @relation(fields: [deviceId], references: [id])
  deviceId  String
  type      String
  payload   Json?
  status    CommandStatus @default(PENDING)
  createdAt DateTime      @default(now())
  sentAt    DateTime?
  ackedAt   DateTime?

  @@index([deviceId])
}

// Incident de seuil (device, type de mesure) avec cycle de vie : ouvert puis
// résolu — voir domain/services/alerts.ts et ADR 0014. Au plus une alerte
// ouverte par couple : `openKey` vaut "deviceId:type" tant que l'alerte est
// ouverte, NULL une fois résolue. PostgreSQL accepte plusieurs NULL dans une
// colonne unique, ce qui équivaut à un index unique partiel
// `WHERE resolvedAt IS NULL` — que Prisma 6 ne sait pas déclarer (un index
// créé en SQL hors schéma serait supprimé au prochain `migrate dev`).
model Alert {
  id              String    @id @default(uuid())
  device          Device    @relation(fields: [deviceId], references: [id])
  deviceId        String
  measurementType String
  // 'above_max' | 'below_min' (domain/entities/Alert.ts)
  reason          String
  threshold       Float
  triggerValue    Float
  openedAt        DateTime
  openedEventId   String?
  lastValue       Float
  lastSeenAt      DateTime
  resolvedAt      DateTime?
  resolvedValue   Float?
  resolvedEventId String?
  openKey         String?   @unique

  @@index([deviceId, openedAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
}
